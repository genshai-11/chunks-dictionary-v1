rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public learning content. The app's Cloud Run backend writes with Firebase Admin SDK,
    // which bypasses client rules. Direct browser/client writes remain blocked.
    match /entries/{entryId} {
      allow read: if true;
      allow write: if false;
    }

    match /classes/{classId} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny for everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
